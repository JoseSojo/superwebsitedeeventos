<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {{!-- NAVEGACIÓN SUPERIOR --}}
    <div class="mb-6">
        <a href="/eventos" class="inline-flex items-center text-sm text-gray-500 hover:text-indigo-600 transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Volver a la lista
        </a>
    </div>

    {{!-- HERO / HEADER DEL EVENTO --}}
    <div class="relative bg-gradient-to-r from-indigo-800 to-blue-900 rounded-2xl shadow-xl overflow-hidden mb-8">
        {{!-- Elementos decorativos de fondo --}}
        <div class="absolute top-0 right-0 -mr-10 -mt-10 w-64 h-64 bg-white opacity-5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 -ml-10 -mb-10 w-40 h-40 bg-indigo-400 opacity-10 rounded-full blur-2xl"></div>

        <div class="relative p-8 md:p-12 text-white">
            <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white bg-opacity-20 backdrop-blur-sm border border-white border-opacity-10">
                    {{evento.tipo}}
                </span>
            </div>
            
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
                {{evento.nombre}}
            </h1>

            <div class="flex flex-col md:flex-row gap-6 text-indigo-100 text-sm md:text-base mt-6">
                <div class="flex items-center">
                    <svg class="w-5 h-5 mr-2 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    {{evento.lugar}}
                </div>
                <div class="flex items-center">
                    <svg class="w-5 h-5 mr-2 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    Inicia: {{evento.fechaInicio}}
                </div>
            </div>
        </div>
    </div>

    {{!-- CONTENIDO PRINCIPAL (GRID 2 COLUMNAS) --}}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {{!-- COLUMNA IZQUIERDA: Detalles y Descripción (Ocupa 2/3) --}}
        <div class="lg:col-span-2 space-y-8">
            
            {{!-- Descripción --}}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 md:p-8">
                <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                    Sobre este evento
                </h3>
                <div class="prose prose-indigo text-gray-600 max-w-none">
                    <p class="whitespace-pre-line leading-relaxed">{{evento.descripcion}}</p>
                </div>
            </div>

            {{!-- Categorías --}}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Temas y Categorías</h3>
                <div class="flex flex-wrap gap-2">
                    {{#each evento.categorias}}
                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-medium bg-gray-100 text-gray-700 border border-gray-200">
                            # {{this.categoria.nombre}}
                        </span>
                    {{else}}
                        <p class="text-gray-500 text-sm italic">Sin categorías especificadas.</p>
                    {{/each}}
                </div>
            </div>
        </div>

        {{!-- COLUMNA DERECHA: Sidebar de Información (Ocupa 1/3) --}}
        <div class="lg:col-span-1 space-y-6">

            {{!-- Tarjeta de "Resumen / Acción" --}}
            <div class="bg-white rounded-xl shadow-lg border border-indigo-50 overflow-hidden sticky top-6">
                <div class="bg-gray-50 p-4 border-b border-gray-100">
                    <h3 class="font-bold text-gray-900">Detalles de Asistencia</h3>
                </div>
                
                <div class="p-6 space-y-6">
                    
                    {{!-- Fechas --}}
                    <div>
                        <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Horario</p>
                        <div class="flex justify-between items-start text-sm">
                            <span class="text-gray-600">Inicio:</span>
                            <span class="font-medium text-gray-900 text-right">{{evento.fechaInicio}}</span>
                        </div>
                        <div class="flex justify-between items-start text-sm mt-2">
                            <span class="text-gray-600">Fin:</span>
                            <span class="font-medium text-gray-900 text-right">{{evento.fechaFin}}</span>
                        </div>
                    </div>

                    <div class="border-t border-gray-100"></div>

                    {{!-- Capacidad --}}
                    <div>
                        <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Cupos</p>
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-sm text-gray-600">Capacidad Total</span>
                            <span class="font-bold text-indigo-600 text-lg">{{evento.capacidad}}</span>
                        </div>
                        {{!-- Barra de progreso simulada (visual) --}}
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-indigo-500 h-2 rounded-full" style="width: 45%"></div>
                        </div>
                        <p class="text-xs text-gray-400 mt-1 text-right">Disponible</p>
                    </div>

                    <div class="border-t border-gray-100"></div>

                    {{!-- Responsable --}}
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-sm border border-indigo-200">
                            {{evento.responsable.nombre.[0]}}
                        </div>
                        <div>
                            <p class="text-xs text-gray-500">Organizado por</p>
                            <p class="text-sm font-medium text-gray-900">{{evento.responsable.nombre}}</p>
                            <a href="/unico-portafolio/{{evento.responsable.id}}" class="text-xs text-indigo-600 hover:underline">Portafolio</a>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>