{{!-- HERO SECTION: Encabezado principal con gradiente --}}
<div class="relative bg-gradient-to-r from-indigo-600 to-purple-700 overflow-hidden shadow-2xl mb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <h1 class="text-4xl tracking-tight font-extrabold text-white sm:text-5xl md:text-6xl">
            <span class="block">Gestiona tus eventos</span>
            <span class="block text-indigo-200">al siguiente nivel</span>
        </h1>
        <p class="mt-3 max-w-md mx-auto text-base text-indigo-100 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl">
            Organiza conferencias, talleres y reuniones de manera sencilla. Controla inscripciones, gestiona categorías
            y conecta con tu audiencia.
        </p>
        <div class="mt-10 max-w-sm mx-auto sm:max-w-none sm:flex sm:justify-center">
            {{#if user}}
            <a href="/eventos"
                class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-white hover:bg-gray-50 md:py-4 md:text-lg md:px-10 transition duration-300 transform hover:scale-105">
                Ir al Dashboard
            </a>
            {{else}}
            <a href="/register"
                class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-white hover:bg-gray-50 md:py-4 md:text-lg md:px-10 transition duration-300 transform hover:scale-105 shadow-lg">
                Comenzar Gratis
            </a>
            <a href="/login"
                class="mt-3 sm:mt-0 sm:ml-3 w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-500 bg-opacity-60 hover:bg-opacity-70 md:py-4 md:text-lg md:px-10 backdrop-blur-sm">
                Iniciar Sesión
            </a>
            {{/if}}
        </div>
    </div>

    {{!-- Elemento decorativo de fondo (Círculos) --}}
    <div
        class="absolute top-0 left-0 -mt-10 -ml-10 w-40 h-40 bg-purple-500 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob">
    </div>
    <div
        class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-indigo-500 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000">
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:max-w-5xl mx-auto p-6">
    <div class="md:flex md:items-center md:justify-between mb-6 col-span-2">
        <div>
            lista
        </div>
        <div>
            <form action="/" method="GET" class="flex w-full gap-2">
                <select 
                    name="categoriaId"
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2"
                >
                    <option selected>Categoria</option>
                    {{#each categorias}}
                        <option value="{{this.id}}">{{this.nombre}}</option>
                    {{/each}}
                </select>
                <input 
                    type="text" 
                    name="param" 
                    value="{{param}}"
                    placeholder="Buscar..." 
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2"
                    
                />
                <input 
                    type="number" 
                    name="take" 
                    value="{{take}}"
                    placeholder="0" 
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2"
                    >
                <button type="submit"
                    class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Buscar
                    </button>
            </form>
        </div>
    </div>
    {{#each eventos}}
    <div
        class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-gray-100 flex flex-col h-full">
        <div class="bg-indigo-600 px-4 py-2 flex justify-between items-center">
            <span
                class="text-xs font-bold text-white uppercase tracking-wider bg-indigo-800 bg-opacity-50 px-2 py-1 rounded">
                {{this.tipo}} {{this.id}}
            </span>
            <svg class="w-5 h-5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
        </div>

        <div class="p-5 flex-1 flex flex-col">

            <div class="flex items-start justify-between mb-4">
                <div class="text-sm text-gray-500 flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                        </path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>{{this.lugar}}</span>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-gray-900">{{this.fechaInicio}}</p>
                </div>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight hover:text-indigo-600 transition-colors">
                <a href="/evento/{{this.id}}">{{this.nombre}}</a>
            </h3>

            <p class="text-gray-600 text-sm mb-4 line-clamp-3 flex-1">
                {{this.descripcion}}
            </p>

            <div class="flex flex-wrap gap-2 mb-4">
                {{#each this.categorias}}
                <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                    #{{this.categoria.nombre}}
                </span>
                {{/each}}
            </div>

            <div class="border-t border-gray-100 pt-4 mt-auto">
                <div class="flex justify-between items-center">

                    <div class="flex items-center space-x-2">
                        <div
                            class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 text-xs font-bold">
                            {{this.responsable.nombre.[0]}}
                        </div>
                        <div class="text-xs">
                            <p class="text-gray-900 font-medium">Organiza:</p>
                            <p class="text-gray-500">{{this.responsable.email}}</p>
                        </div>
                    </div>

                    <div class="flex items-center text-gray-500 text-xs" title="Capacidad Máxima">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z">
                            </path>
                        </svg>
                        {{this.capacidad}} cupos
                    </div>
                </div>

                <a href="/unico-evento/{{this.id}}"
                    class="mt-4 w-full block text-center bg-gray-50 hover:bg-indigo-50 text-indigo-600 font-semibold py-2 px-4 rounded border border-gray-200 hover:border-indigo-200 transition-all text-sm">
                    Ver Detalles &rarr;
                </a>
            </div>
        </div>
    </div>
    {{/each}}
    <div class="md:flex md:items-center md:justify-between mb-6 col-span-2">
        <a 
            href="/?skip={{skip}}&take={{take}}"
            class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-full" 
        >
            Ver más
        </a>
    </div>

</div>

{{!-- FEATURES SECTION: Beneficios --}}
<div class="py-12 bg-white rounded-xl shadow-sm mb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="text-base text-indigo-600 font-semibold tracking-wide uppercase">Características</h2>
            <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                Todo lo que necesitas
            </p>
        </div>

        <div class="mt-10">
            <dl class="space-y-10 md:space-y-0 md:grid md:grid-cols-3 md:gap-x-8 md:gap-y-10">

                {{!-- Feature 1 --}}
                <div class="relative">
                    <dt>
                        <div
                            class="absolute flex items-center justify-center h-12 w-12 rounded-md bg-indigo-500 text-white">
                            {{!-- Icono SVG --}}
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <p class="ml-16 text-lg leading-6 font-medium text-gray-900">Gestión de Tiempo</p>
                    </dt>
                    <dd class="mt-2 ml-16 text-base text-gray-500">
                        Programa tus eventos con fechas exactas y mantén a tus asistentes informados.
                    </dd>
                </div>

                {{!-- Feature 2 --}}
                <div class="relative">
                    <dt>
                        <div
                            class="absolute flex items-center justify-center h-12 w-12 rounded-md bg-indigo-500 text-white">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <p class="ml-16 text-lg leading-6 font-medium text-gray-900">Control de Asistentes</p>
                    </dt>
                    <dd class="mt-2 ml-16 text-base text-gray-500">
                        Gestiona listas de invitados, categorías de usuarios y permisos de acceso.
                    </dd>
                </div>

                {{!-- Feature 3 --}}
                <div class="relative">
                    <dt>
                        <div
                            class="absolute flex items-center justify-center h-12 w-12 rounded-md bg-indigo-500 text-white">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                            </svg>
                        </div>
                        <p class="ml-16 text-lg leading-6 font-medium text-gray-900">Reportes Claros</p>
                    </dt>
                    <dd class="mt-2 ml-16 text-base text-gray-500">
                        Visualiza qué eventos tienen más éxito y organiza mejor tu próxima estrategia.
                    </dd>
                </div>
            </dl>
        </div>
    </div>
</div>

{{!-- CTA FINAL --}}
<div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-200">
    <h3 class="text-2xl font-bold text-gray-900">¿Listo para empezar?</h3>
    <p class="mt-2 text-gray-600 mb-6">Únete hoy y crea tu primer evento en menos de 5 minutos.</p>
    {{#if user}}
    <a href="/eventos/create" class="text-indigo-600 font-semibold hover:text-indigo-800">Crear un evento ahora
        &rarr;</a>
    {{else}}
    <a href="/register" class="text-indigo-600 font-semibold hover:text-indigo-800">Crear cuenta gratis &rarr;</a>
    {{/if}}
</div>